    "privateSignals": ["profile", "security", "notifications", "support"],
    "browserTesterApprovalEnabled": false
  },
  "requiredChecks": [
    "typecheck",
    "typecheck:e2e",
    "build",
    "check:analytics",
    "check:beta-access",
    "check:beta-operations",
    "check:production-experience",
    "check:bundle",
    "check:release",
    "check:navigation",
    "check:security",
    "check:beta",
    "check:hosting",
    "test:e2e",
    "test:e2e:production",
    "production-dependency-audit"
  ],
  "manualPrerequisites": [
    "production-domain-and-rollback-validation",
    "exact-web-origin-and-auth-redirects",
    "custom-auth-smtp-and-abuse-controls",
    "controller-privacy-terms-and-support-contacts",
    "monitoring-on-call-and-incident-exercise",
    "approved-tester-list-and-feedback-process"
  ]
}
