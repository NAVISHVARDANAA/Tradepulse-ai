{
  "schemaVersion": 1,
  "release": "controlled-beta-rc2",
  "phase": "4X",
  "status": "hosting_deployment_candidate",
  "audience": "internal_release_review",
  "hardLocks": {
    "liveBrokerageExecution": false,
    "paymentExecution": false,
    "chargeCollection": false,
    "custody": false,
    "personalizedAdvice": false
  },
  "distribution": {
    "hostingProviderSelected": true,
    "publicUrlConfigured": false,
    "externalInvitationsApproved": false
