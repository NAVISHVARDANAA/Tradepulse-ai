{
  "name": "tradepulse-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:analytics": "node scripts/assert-analytics-studio.mjs",
    "check:bundle": "node scripts/assert-frontend-budgets.mjs",
    "check:beta": "node scripts/assert-beta-readiness.mjs",
    "check:hosting": "node scripts/assert-cloudflare-hosting.mjs",
    "check:navigation": "node scripts/assert-product-navigation.mjs",
    "check:release": "node scripts/assert-web-release.mjs",
    "check:security": "node scripts/assert-security-regression.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "verify:web-deployment": "node scripts/verify-web-deployment.mjs",
    "typecheck": "tsc -b --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "supabase": "^2.114.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
